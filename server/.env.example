NODE_ENV=development
LOG_LEVEL=info
PORT=8080
# ── Supabase Postgres (Drizzle ORM) ──
# Use the "Transaction" pooler connection string (port 6543) for serverless
# deploys. URL-encode special chars in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 'no-verify' relaxes TLS cert verification for Supabase; omit for strict TLS.
DATABASE_SSL=no-verify
DATABASE_POOL_MAX=10
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRES_IN=7d
# ── Face recognition microservice (see /face-service) ──
# Deployed URL of the Python face-service. Empty = feature disabled (falls back
# to client-side face-api match). Example: https://face-xxxx.onrender.com
FACE_SERVICE_URL=
# Optional shared secret; must equal the face-service's FACE_SERVICE_TOKEN.
FACE_SERVICE_TOKEN=
# Comma-separated list of allowed browser origins. Empty = allow all.
CORS_ORIGIN=http://localhost:5173
# Frontend base URL used inside emails (reset links, CTA buttons)
FRONTEND_URL=http://localhost:5173
VPNAPI_KEY=your-vpnapi-key-from-vpnapi-io
UPLOAD_DIR=uploads
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# ── SMTP (optional – mails log to console when absent) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=
SMTP_PASSWORD=

# ── Cloudflare R2 Object Storage (selfies, documents, medicine images) ──
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=platform-attendease
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

