NODE_ENV=development
LOG_LEVEL=info
PORT=8080
MONGO_URI=mongodb+srv://your-user:your-pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins. Empty = allow all.
CORS_ORIGIN=http://localhost:5173
# Frontend base URL used inside emails (reset links, CTA buttons)
FRONTEND_URL=http://localhost:5173
VPNAPI_KEY=your-vpnapi-key-from-vpnapi-io
UPLOAD_DIR=uploads
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# ── SMTP (optional – mails log to console when absent) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=
SMTP_PASSWORD=

# ── Cloudflare R2 Object Storage (selfies, documents, medicine images) ──
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=platform-attendease
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

